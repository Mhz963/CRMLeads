# Supabase (existing)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of your app (used for Stripe success/cancel redirects)
APP_PUBLIC_URL=https://your-project.vercel.app

# Stripe — NEVER commit real keys. Use Vercel env for production; .env is gitignored locally.
STRIPE_SECRET_KEY=
# Safe to expose in the browser (pk_* only)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Checkout uses inline amounts (no Dashboard price_... IDs required).
# Optional overrides (integer cents). Defaults: 1900 / 4900 / 9900.
# STRIPE_AMOUNT_STARTER_CENTS=1900
# STRIPE_AMOUNT_GROWTH_CENTS=4900
# STRIPE_AMOUNT_PRO_CENTS=9900
# STRIPE_CURRENCY=usd

# Optional: if you later create fixed Prices in Stripe, you can map them for webhooks:
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_PRO=price_...

# Webhook: POST https://YOUR_DOMAIN/api/subscriptions
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted

# Email alerts for invoices/reminders (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="CRM Leads <billing@your-domain.com>"
